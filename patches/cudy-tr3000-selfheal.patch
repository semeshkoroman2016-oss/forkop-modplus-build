 function ensure_sing_box_main_section() {
+    if (uci_core.exists("sing-box.main"))
+        return true;
+
+    /* Forkop MOD+ Cudy FIX-00: uci_core cannot always create a new
+     * package file from scratch on OpenWrt 25.12.  Seed the minimal
+     * sing-box UCI config when the sidecar is present but its package
+     * config is missing.  Existing user configuration is never overwritten. */
+    if (!file_exists(SB_UCI_CONFIG_FILE)) {
+        let default_config =
+            "config sing-box 'main'\n" +
+            "option enabled '0'\n" +
+            "option user 'root'\n" +
+            "option conffile '/etc/sing-box/config.json'\n" +
+            "option workdir '/usr/share/sing-box'\n" +
+            "option log_stderr '1'\n";
+        if (!write_file(SB_UCI_CONFIG_FILE, default_config))
+            return false;
+        command_success_from_args([ "chmod", "0600", SB_UCI_CONFIG_FILE ]);
+        command_success_from_args([ "mkdir", "-p", "/etc/sing-box", "/usr/share/sing-box" ]);
+        log_message("Created missing sing-box UCI sidecar configuration", "info");
+    }
+
     if (uci_core.exists("sing-box.main"))
         return true;
     return uci_core.set_section("sing-box.main", "sing-box");
